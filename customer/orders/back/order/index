<script>
let currentStatus = '';

function showToast(message, isError = false) {
    const toast = document.getElementById('toastMessage');
    toast.textContent = message;
    toast.style.backgroundColor = isError ? '#dc2626' : '#10b981';
    toast.style.opacity = '1';
    setTimeout(() => { toast.style.opacity = '0'; }, 3000);
}

async function loadOrders(status = '') {
    try {
        const url = window.location.pathname + '?ajax=1' + (status ? '&status=' + encodeURIComponent(status) : '');
        const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await response.json();
        
        // Update statistics cards
        document.getElementById('statTotal').innerText = data.stats.total;
        document.getElementById('statPending').innerText = data.stats.pending;
        document.getElementById('statAccepted').innerText = data.stats.accepted;
        document.getElementById('statConfirmed').innerText = data.stats.confirmed;
        document.getElementById('statPreparing').innerText = data.stats.preparing;
        document.getElementById('statReady').innerText = data.stats.ready;
        document.getElementById('statPickedUp').innerText = data.stats.picked_up;
        document.getElementById('statInTransit').innerText = data.stats.in_transit;
        document.getElementById('statDelivered').innerText = data.stats.delivered;
        document.getElementById('statCancelled').innerText = data.stats.cancelled;
        
        // Highlight active stat card
        document.querySelectorAll('.stat-card').forEach(card => {
            if (card.getAttribute('data-status') === status) {
                card.classList.add('active');
            } else {
                card.classList.remove('active');
            }
        });
        
        // Build table rows
        const tbody = document.getElementById('ordersTableBody');
        if (data.orders.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="empty-state"><i class="fas fa-inbox"></i><p>No orders found</p><a href="../products/index.php" style="color: #e67e22;">Start Shopping →</a></td></tr>';
            return;
        }
        
        let html = '';
        for (const order of data.orders) {
            let statusClass = order.status;
            let statusIcon = 'clock';
            if (order.status === 'delivered') statusIcon = 'check-circle';
            else if (order.status === 'cancelled') statusIcon = 'times-circle';
            else if (order.status === 'accepted') statusIcon = 'check-circle';
            else if (order.status === 'confirmed') statusIcon = 'check-double';
            else if (order.status === 'preparing') statusIcon = 'cogs';
            else if (order.status === 'ready') statusIcon = 'box-open';
            else if (order.status === 'picked_up') statusIcon = 'truck';
            else if (order.status === 'in_transit') statusIcon = 'truck';
            
            let displayStatus = order.status.replace('_', ' ');
            displayStatus = displayStatus.charAt(0).toUpperCase() + displayStatus.slice(1);
            
            // Build action buttons
            let actionsHtml = `<a href="details.php?id=${order.order_id}" class="btn-sm btn-view"><i class="fas fa-eye"></i> View</a>`;
            
            // Track button - for in_progress deliveries
            if (order.status !== 'pending' && order.status !== 'delivered' && order.status !== 'cancelled') {
                actionsHtml += `<a href="track.php?id=${order.order_id}" class="btn-sm btn-track"><i class="fas fa-truck"></i> Track</a>`;
            }
            
       
            // RATE DELIVERY BUTTON - NEW
            if (order.status === 'delivered' && order.delivery_id) {
                if (!order.is_rated) {
                    actionsHtml += `<a href="../rate/rate-delivery.php?id=${order.delivery_id}" class="btn-sm btn-rate"><i class="fas fa-star"></i> Rate</a>`;
                } else {
                    actionsHtml += `<span class="btn-sm btn-rated"><i class="fas fa-check-circle"></i> Rated</span>`;
                }
            }
            
            // Cancel button - only for pending
            if (order.status === 'pending') {
                actionsHtml += `<a href="cancel.php?id=${order.order_id}" class="btn-sm btn-cancel" onclick="return confirm('Cancel this order?')"><i class="fas fa-times"></i> Cancel</a>`;
            }
            
            // Invoice button - only for delivered
            if (order.status === 'delivered') {
                actionsHtml += `<a href="invoice.php?id=${order.order_id}" class="btn-sm btn-view" target="_blank"><i class="fas fa-print"></i> Invoice</a>`;
            }
            
            // Delete button - for pending or cancelled
            if (order.status === 'pending' || order.status === 'cancelled') {
                actionsHtml += `<a href="delete.php?id=${order.order_id}" class="btn-sm btn-delete" onclick="return confirm('⚠️ Permanently delete this order? This action cannot be undone.')"><i class="fas fa-trash-alt"></i> Delete</a>`;
            }
            
            html += `<tr>
                <td class="order-id">${order.order_id}</td>
                <td>${escapeHtml(order.business_name)}</td>
                <td>${new Date(order.order_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                <td>${order.item_count} items</td>
                <td><strong>TSh ${formatNumber(order.grand_total)}</strong></td>
                <td><span class="status-badge status-${statusClass}"><i class="fas fa-${statusIcon}"></i> ${displayStatus}</span></td>
                <td class="action-buttons">${actionsHtml}</td>
            </tr>`;
        }
        tbody.innerHTML = html;
    } catch (err) {
        console.error(err);
        document.getElementById('ordersTableBody').innerHTML = '<tr><td colspan="7" class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>Error loading orders. Please refresh.</p></td></tr>';
        showToast('Failed to load orders', true);
    }
}

function formatNumber(num) {
    return new Intl.NumberFormat().format(num);
}

function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// Filter buttons
document.querySelectorAll('#filters .quick-filter').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('#filters .quick-filter').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentStatus = this.getAttribute('data-status');
        loadOrders(currentStatus);
    });
});

// Stat cards clickable
document.querySelectorAll('.stat-card').forEach(card => {
    card.addEventListener('click', function() {
        const status = this.getAttribute('data-status');
        document.querySelectorAll('#filters .quick-filter').forEach(btn => {
            if (btn.getAttribute('data-status') === status) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
        currentStatus = status;
        loadOrders(currentStatus);
    });
});

// Initial load
loadOrders();

// Auto-remove flash message
const flashDiv = document.querySelector('#flashContainer .alert');
if (flashDiv) {
    setTimeout(() => { flashDiv.style.display = 'none'; }, 3000);
}
</script>
