    <script>
        const form = document.getElementById('statusForm');
        const toast = document.getElementById('toast');
        const paymentCheckbox = document.getElementById('paymentConfirmed');
        const paymentInput = document.getElementById('paymentConfirmedInput');
        const submitBtn = document.getElementById('submitBtn');
        const statusSelect = document.getElementById('newStatus');
        const paymentConfirmBox = document.getElementById('paymentConfirmBox');

        // Show payment confirmation when selecting 'delivered' for COD
        if (paymentConfirmBox) {
            statusSelect.addEventListener('change', function() {
                if (this.value === 'delivered') {
                    paymentConfirmBox.style.display = 'block';
                } else {
                    paymentConfirmBox.style.display = 'none';
                }
            });
        }

        // Update hidden input when checkbox changes
        if (paymentCheckbox) {
            paymentCheckbox.addEventListener('change', function() {
                paymentInput.value = this.checked ? '1' : '0';
            });
        }

        function showToast(message, isError = false) {
            toast.textContent = message;
            toast.style.backgroundColor = isError ? '#dc2626' : '#10b981';
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 4000);
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const newStatus = document.getElementById('newStatus').value;
            const paymentConfirmed = document.getElementById('paymentConfirmed')?.checked ? 1 : 0;
            
            // Check if COD and trying to deliver without payment confirmation
            <?php if ($payment_method == 'cash_on_delivery' && $payment_status != 'paid'): ?>
            if (newStatus === 'delivered' && paymentConfirmed !== 1) {
                showToast('⚠️ Please confirm that you have collected cash payment before marking as delivered.', true);
                return;
            }
            <?php endif; ?>

            try {
                const response = await fetch(window.location.href, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json', 
                        'X-Requested-With': 'XMLHttpRequest' 
                    },
                    body: JSON.stringify({ 
                        new_status: newStatus,
                        payment_confirmed: paymentConfirmed
                    })
                });
                const result = await response.json();
                
                if (result.success) {
                    showToast(result.message);
                    setTimeout(() => { 
                        window.location.href = '../my-deliveries/my-deliveries.php'; 
                    }, 1500);
                } else {
                    showToast(result.message, true);
                }
            } catch (err) {
                showToast('Network error. Please try again.', true);
            }
        });
    </script>
