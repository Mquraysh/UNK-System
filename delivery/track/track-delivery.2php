<?php
require_once '../../config/database.php';
session_start();

if (!isset($_SESSION['user_id']) || $_SESSION['role'] != 'delivery') {
    header("Location: ../login.php");
    exit();
}

$user_id = $_SESSION['user_id'];

$agent_sql = "SELECT * FROM delivery_agents WHERE user_id='$user_id'";
$agent_result = mysqli_query($conn, $agent_sql);
$agent = mysqli_fetch_assoc($agent_result);

if (!$agent) {
    header("Location: ../register.php");
    exit();
}

$agent_id = $agent['agent_id'];

if (!isset($_GET['id']) || !is_numeric($_GET['id'])) {
    $_SESSION['flash_message'] = "Invalid delivery.";
    $_SESSION['flash_type'] = "danger";
    header("Location: ../my-deliveries/my-deliveries.php");
    exit();
}

$delivery_id = (int)$_GET['id'];

$sql = "SELECT
            d.*,
            o.order_id,
            o.delivery_address,
            o.contact_phone,
            o.order_date,
            o.delivery_fee,
            o.grand_total,
            b.business_name,
            b.location AS pickup_location
        FROM deliveries d
        JOIN orders o ON d.order_id=o.order_id
        JOIN businesses b ON o.business_id=b.business_id
        WHERE d.delivery_id='$delivery_id'
        AND d.agent_id='$agent_id'
        LIMIT 1";

$result = mysqli_query($conn, $sql);

if(mysqli_num_rows($result)==0){
    $_SESSION['flash_message']="Delivery not found.";
    $_SESSION['flash_type']="danger";
    header("Location: ../my-deliveries/my-deliveries.php");
    exit();
}

$delivery = mysqli_fetch_assoc($result);

$currentStatus = $delivery['status'];

function completed($step,$current){

    $order=[
        'assigned'=>1,
        'picked_up'=>2,
        'in_transit'=>3,
        'delivered'=>4
    ];

    if($order[$step] < $order[$current]){
        return 'completed';
    }

    if($order[$step] == $order[$current]){
        return 'active';
    }

    return '';
}

include '../includes/delivery_sidebar.php';
?>

